# URL base del stage, sin /v1. Copiar este archivo a frontend/.env.local.
VITE_API_BASE_URL=

# Salidas públicas de Cognito.
VITE_COGNITO_ISSUER=
VITE_COGNITO_LOGIN_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Valor exacto de ApiAudience en API Gateway. Puede diferir de VITE_API_BASE_URL.
VITE_API_AUDIENCE=

# Opcional. Configurar cuando P3 publique el listado protegido de borradores.
VITE_DRAFT_LIST_PATH=
